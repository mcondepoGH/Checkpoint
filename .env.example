# Copia a .env. Solo hacen falta CHECKPOINT_USER y CHECKPOINT_PASSWORD.
# La contraseña va en claro (acceso solo LAN): restringe los permisos del .env (chmod 600).
CHECKPOINT_USER=admin
CHECKPOINT_PASSWORD=cambia-esto
# Puerto publicado en el equipo anfitrión (dentro del contenedor la web escucha en el 8088)
CHECKPOINT_PORT=8088
CHECKPOINT_SESSION_HOURS=12
# Zona horaria de los registros y la sincronización automática (por defecto UTC), p. ej. Europe/London
# TZ=UTC
PUID=1000
PGID=1000
# Tras un proxy inverso con HTTPS:
# CHECKPOINT_COOKIE_SECURE=1
# CHECKPOINT_TRUST_PROXY=1
# Sincronización automática y comprobación de versiones: se ajustan desde la pantalla Configuración.

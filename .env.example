# Copia a .env. Solo hacen falta SAVESYNC_USER y SAVESYNC_PASSWORD.
# La contraseña va en claro (acceso solo LAN): restringe los permisos del .env (chmod 600).
SAVESYNC_USER=admin
SAVESYNC_PASSWORD=cambia-esto
SAVESYNC_PORT=8088
SAVESYNC_SESSION_HOURS=12
TZ=Europe/Madrid
PUID=1000
PGID=1000
# Sincronización automática (valores iniciales; lo guardado desde la pantalla Configuración prevalece)
# SAVESYNC_AUTO_ENABLED=1
# SAVESYNC_AUTO_INTERVAL_HOURS=24
# SAVESYNC_AUTO_RUN_ON_START=0
# SAVESYNC_COOKIE_SECURE=1
# SAVESYNC_TRUST_PROXY=1

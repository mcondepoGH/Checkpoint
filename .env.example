# Copia a .env. Solo hacen falta CHECKPOINT_USER y CHECKPOINT_PASSWORD.
# La contraseña va en claro (acceso solo LAN): restringe los permisos del .env (chmod 600).
CHECKPOINT_USER=admin
CHECKPOINT_PASSWORD=cambia-esto
CHECKPOINT_PORT=8088
CHECKPOINT_SESSION_HOURS=12
TZ=Europe/Madrid
PUID=1000
PGID=1000
# Sincronización automática (valores iniciales; lo guardado desde la pantalla Configuración prevalece)
# CHECKPOINT_AUTO_ENABLED=1
# CHECKPOINT_AUTO_INTERVAL_HOURS=24
# CHECKPOINT_AUTO_RUN_ON_START=0
# CHECKPOINT_COOKIE_SECURE=1
# CHECKPOINT_TRUST_PROXY=1
# Comprobación de nuevas versiones (GitHub Releases, solo lectura; lo guardado desde Configuración prevalece)
# En Docker la comprobación va DESACTIVADA por defecto (se actualiza reconstruyendo la imagen). Para activarla,
# define CHECKPOINT_UPDATE_CHECK=1 de forma explícita. Sin Docker (nativo) está siempre activa; ahí 0 la desactiva.
# CHECKPOINT_UPDATE_CHECK=1
# CHECKPOINT_UPDATE_CHANNEL=stable   # stable | beta (pruebas: incluye versiones preliminares)
# CHECKPOINT_UPDATE_REPO=mcondepoGH/Checkpoint
# CHECKPOINT_UPDATE_CACHE_HOURS=6

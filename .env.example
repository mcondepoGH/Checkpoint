# Copia a .env. Solo hacen falta estas dos variables.
# La contraseña va en claro (acceso solo LAN): restringe los permisos del .env (chmod 600).
CHECKPOINT_USER=admin
CHECKPOINT_PASSWORD=cambia-esto

# Opcional: idioma por defecto de la interfaz (es | en; sin marcar = es). Para usarlo, descomenta también
# CHECKPOINT_LANG en docker-compose.yml.
# CHECKPOINT_LANG=es

{
  "name": "checkpoint-ui",
  "private": true,
  "version": "1.10.0",
  "type": "module",
  "imports": { "#src/*": "./src/*" },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "node --test \"test/**/*.test.mjs\"",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{js,jsx,scss}\" \"test/**/*.mjs\" \"scripts/**/*.mjs\" vite.config.js eslint.config.js",
    "format:check": "prettier --check \"src/**/*.{js,jsx,scss}\" \"test/**/*.mjs\" \"scripts/**/*.mjs\" vite.config.js eslint.config.js"
  },
  "dependencies": { "react": "18.3.1", "react-dom": "18.3.1", "swagger-ui-dist": "5.34.0" },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@vitejs/plugin-react": "4.3.4",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "prettier": "3.10.0",
    "sass": "1.83.4",
    "vite": "6.0.7"
  }
}

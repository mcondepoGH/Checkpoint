{
  "name": "checkpoint-ui",
  "private": true,
  "version": "1.10.1",
  "type": "module",
  "imports": { "#src/*": "./src/*" },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "node --test \"test/**/*.test.mjs\"",
    "test:coverage": "node scripts/check-coverage.mjs",
    "check:size": "node scripts/check-bundle-size.mjs",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{js,jsx,scss}\" \"test/**/*.mjs\" \"scripts/**/*.mjs\" vite.config.js eslint.config.js",
    "format:check": "prettier --check \"src/**/*.{js,jsx,scss}\" \"test/**/*.mjs\" \"scripts/**/*.mjs\" vite.config.js eslint.config.js"
  },
  "dependencies": { "react": "19.3.1", "react-dom": "19.3.1", "swagger-ui-dist": "5.34.1" },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "prettier": "3.10.0",
    "sass": "1.108.1",
    "vite": "8.3.6"
  }
}
